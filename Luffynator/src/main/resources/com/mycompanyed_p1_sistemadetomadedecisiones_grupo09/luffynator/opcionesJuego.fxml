<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Text?>

<Pane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompanyed_p1_sistemadetomadedecisiones_grupo09.luffynator.OpcionesJuegoController">
    <stylesheets>
        <URL value="@/styles/inicio.css" />
    </stylesheets>
   <children>
      <!-- Texto principal con el nombre Luffynator -->
      <Label id="titleLabel" layoutX="242.0" layoutY="81.0" text="Luffynator" />

      <!-- Imagen del personaje (aquí puedes colocar una imagen de Luffy si tienes una) -->
      <Label id="imageLabel" layoutX="655.0" layoutY="73.0" text="👒" /> <!-- Sustituye el texto por una imagen -->

      <!-- Botón para jugar -->
      <Button id="playButton" fx:id="primaryButton" layoutX="361.0" layoutY="393.0" onAction="#jugar" text="Jugar" />
      <TextField layoutX="383.0" layoutY="245.0" />
      <Text layoutX="234.0" layoutY="262.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Número de preguntas:" />
      <Button fx:id="volverButton" layoutX="83.0" layoutY="393.0" mnemonicParsing="false" onAction="#volver" text="Volver" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</Pane>
