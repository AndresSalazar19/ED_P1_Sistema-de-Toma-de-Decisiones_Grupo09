<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompanyed_p1_sistemadetomadedecisiones_grupo09.luffynator.PreguntasController">
    <stylesheets>
        <URL value="@/styles/preguntas.css" />
    </stylesheets>
    <children>
        <!-- Caja de Pregunta -->
        <!-- Contenedor para el cuadro de diálogo -->
        <HBox fx:id="dialogBox" layoutX="245.0" layoutY="141.0" styleClass="dialog-box">
         <children>
               <Label fx:id="preguntaLabel" styleClass="pregunta-label" text="Pregunta" />
         </children>
        </HBox>
        <Button fx:id="volverButton" layoutX="45.0" layoutY="481.0" mnemonicParsing="false" onAction="#volver" styleClass="button-general" text="Volver" />
        <!-- Botones de respuesta -->
        <Button fx:id="siButton" layoutX="250" layoutY="200" mnemonicParsing="false" styleClass="button-general" text="Sí" />
        <Button fx:id="noButton" layoutX="450" layoutY="200" mnemonicParsing="false" styleClass="button-general" text="No" />
        <Button fx:id="prevButton" layoutX="84.0" layoutY="328.0" mnemonicParsing="false" styleClass="button-general" text="Prev" visible="false" />
        <Button fx:id="nextButton" layoutX="565.0" layoutY="340.0" mnemonicParsing="false" styleClass="button-general" text="Next" visible="false" />
      
        <!-- Caja texturizada para la imagen del animal -->
        <VBox fx:id="animalImageBox" layoutX="250.0" layoutY="233.0" prefHeight="200" prefWidth="300" styleClass="animal-image-box" visible="false">
            <children>
                <ImageView fx:id="animalImageView" fitHeight="180" fitWidth="280" preserveRatio="true" />
            </children>
        </VBox>
        <!-- Etiqueta de Animal -->
        <Label fx:id="animalLabel" layoutX="362.0" layoutY="248.0" styleClass="animal-label" text="Animal" />

        <!-- Botón Agregar Animal -->
        <Button fx:id="agregarAnimalButton" layoutX="331.0" layoutY="400.0" mnemonicParsing="false" styleClass="add-animal-button" text="Agregar Animal" visible="false" />
    </children>
</Pane>
