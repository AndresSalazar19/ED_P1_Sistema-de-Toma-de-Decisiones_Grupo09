<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane id="AnchorPane" prefHeight="400.0" prefWidth="600.0" stylesheets="@../../../styles/agregarAnimal.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompanyed_p1_sistemadetomadedecisiones_grupo09.luffynator.AgregarAnimalController">    
        <children>
        <Label layoutX="190.0" layoutY="84.0" text="Ingrese el nombre del animal:" />
        <TextField fx:id="animalTextField" layoutX="190.0" layoutY="108.0" promptText="Nombre del animal" />
        
        <Label layoutX="190.0" layoutY="150.0" text="Agregar imagen:" />
        <Button fx:id="addImageButton" layoutX="190.0" layoutY="175.0" onAction="#handleAddImage" text="Seleccionar Imagen" />
        <ImageView fx:id="animalImageView" fitHeight="150" fitWidth="150" layoutX="203.0" layoutY="222.0" visible="false" />
        
        <Button fx:id="saveButton" layoutX="456.0" layoutY="347.0" onAction="#handleSaveAnimal" text="Guardar Animal" />
        <Button fx:id="cancelButton" layoutX="51.0" layoutY="347.0" onAction="#handleCancel" text="Cancelar" />
    </children>
</AnchorPane>
