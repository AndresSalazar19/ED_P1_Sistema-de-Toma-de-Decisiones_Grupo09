<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>

<Pane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompanyed_p1_sistemadetomadedecisiones_grupo09.luffynator.InicioController">
    <stylesheets>
        <URL value="@/styles/inicio.css" />
    </stylesheets>
   <children>
      <ImageView fx:id="luffyInicio" fitHeight="465.0" fitWidth="807.0" layoutX="87.0" layoutY="36.0" pickOnBounds="true" preserveRatio="true" /> <!-- Sustituye el texto por una imagen -->

      <!-- Botón para jugar -->
    <Button fx:id="ComenzarButton" layoutX="301.0" layoutY="514.0" onAction="#comenzar" styleClass="button-general" text="Comenzar" />
      <Button fx:id="archPreguntas" layoutX="43.0" layoutY="526.0" mnemonicParsing="false" onAction="#cambiarArchivoPreguntas" text="Cargar Archivo Preguntas" />
      <Button fx:id="archResp" layoutX="577.0" layoutY="526.0" mnemonicParsing="false" onAction="#cambiarArchivoRespuestas" text="Cargar Archivo Respuestas" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</Pane>
