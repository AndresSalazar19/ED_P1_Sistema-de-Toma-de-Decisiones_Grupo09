<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.Pane?>

<Pane id="AnchorPane" prefHeight="600.0" prefWidth="800.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompanyed_p1_sistemadetomadedecisiones_grupo09.luffynator.InicioController">
    <stylesheets>
        <URL value="@/styles/inicio.css" />
    </stylesheets>
   <children>
      <!-- Texto principal con el nombre Luffynator -->
      <Label id="titleLabel" layoutX="346.0" layoutY="283.0" text="Luffynator" />

      <!-- Imagen del personaje (aquí puedes colocar una imagen de Luffy si tienes una) -->
      <Label id="imageLabel" layoutX="361.0" layoutY="224.0" text="👒" /> <!-- Sustituye el texto por una imagen -->

      <!-- Botón para jugar -->
      <Button id="playButton" fx:id="primaryButton" layoutX="351.0" layoutY="377.0" onAction="#switchToSecondary" text="Jugar" />

      <!-- Información adicional como estadísticas -->
      <Label id="statsLabel" layoutX="147.0" layoutY="135.0" text="2236 Gente jugando en estos momentos.\n103027501 Partidas jugadas 58332 Hoy." />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</Pane>
