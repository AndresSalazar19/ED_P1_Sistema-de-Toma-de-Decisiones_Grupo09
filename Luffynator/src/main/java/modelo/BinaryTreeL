    private BinaryTreeL anadirPregunta(ArrayList<String> preguntas, int index){// se vera como hacerlo para que se limite dependiendo del indece que ponga el usuario
        if(index >= preguntas.size()){
            return null;
        
        }
        String pregunta = preguntas.get(index);
        BinaryTreeL nodopregunta = new BinaryTreeL(pregunta);
       
        
        if(!pregunta.contains("¿") || (!pregunta.contains("?"))){
            return nodopregunta;
        }else{
            if(nodopregunta.getRoot().left == null){

                nodopregunta.getRoot().left = anadirPregunta(preguntas, index+1);
            }
            if(nodopregunta.getRoot().right == null){
                nodopregunta.getRoot().right = anadirPregunta(preguntas, index+1);
            }
                
        }
        
        return nodopregunta;
        
    }
    
    
