    public String toString(){
        
        if ( isEmpty() ) return "[ ]";
        String texto = "[ ";
        ArrayList<String> contenido = InOrder();
        
        for ( int i = 0; i < contenido.size() - 1; i++ ){
            texto += contenido.get(i) + ", ";
        }
        texto+= contenido.get( contenido.size()-1) + " ]";
        
        return texto;
    }
    
